# MongoDB
MONGODB_URI=mongodb://localhost:27017/crm

# JWT
JWT_SECRET=change-this-to-a-random-secret

# Next.js
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Maps API Key (get from https://console.cloud.google.com/)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# WhatsApp Webhook
WHATSAPP_VERIFY_TOKEN=devweb_patagonia_2026
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id
WHATSAPP_ACCESS_TOKEN=your_meta_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id

# Cloudinary (https://cloudinary.com/)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Maintenance Mode
# Set to 'true' to enable maintenance mode
# When enabled, regular users cannot access CRM or use WhatsApp bot
# Only authorized users/phones can bypass
MAINTENANCE_MODE=false

# Email of user authorized to bypass maintenance mode (CRM)
# Only this user can access CRM during maintenance
MAINTENANCE_ADMIN_EMAIL=

# Phone number authorized to bypass maintenance mode (WhatsApp)
# Only this number can use the bot during maintenance
# Use E.164 format: 5492984252859 ( Argentina)
MAINTENANCE_TEST_PHONE=
